<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>دليل مناطق دبي | تصور امتلاك جلوبال</title>
<style>
:root{
  --navy:#102d45;--teal:#007f84;--gold:#bc9146;
  --ink:#19354a;--muted:#5c7080;--line:#dce5eb;
  --paper:#fff;--soft:#f2f6f8;--tint:#eaf5f4;
}
*{box-sizing:border-box}
body{
  margin:0;background:#e8eef2;color:var(--ink);
  font-family:Tahoma,Arial,sans-serif;line-height:1.8;
}
button,input,select{font:inherit}
button{cursor:pointer}
button:focus-visible,input:focus-visible,select:focus-visible{
  outline:3px solid var(--gold);outline-offset:3px;
}
.toolbar{
  position:sticky;top:0;z-index:20;background:var(--navy);
  color:#fff;padding:12px 22px;display:flex;align-items:center;
  justify-content:space-between;gap:12px;flex-wrap:wrap;
  box-shadow:0 4px 20px #102d4520;
}
.toolbar strong{font-size:15px}
.tools{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.toolbar button,.toolbar select{
  border:1px solid #ffffff45;border-radius:8px;
  background:#ffffff10;color:#fff;padding:7px 12px;
}
.toolbar select{max-width:260px}
.toolbar option{color:var(--ink);background:#fff}
.toolbar button:hover{background:#ffffff22}
.toolbar button:disabled{opacity:.35;cursor:default}
.toolbar button[aria-pressed="true"]{background:var(--teal)}
.progress{height:4px;background:#d4e1e8}
.progress span{height:100%;display:block;background:var(--gold);transition:width .2s}
main{max-width:1450px;margin:24px auto;padding:0 24px}
.slide{
  display:none;background:var(--paper);min-height:760px;
  border-radius:15px;overflow:hidden;
  box-shadow:0 12px 40px #15314912;
}
.slide.active{display:flex;flex-direction:column}
.slide-head{
  padding:28px 44px 0;display:flex;justify-content:space-between;
  align-items:center;gap:16px;color:var(--muted);font-size:13px;
}
.brand{color:var(--navy);font-weight:bold;font-size:20px;line-height:1.3}
.brand small{
  font-size:10px;display:block;letter-spacing:2px;
  font-weight:normal;margin-top:5px;direction:ltr;text-align:right;
}
.chapter{padding:4px 11px;background:var(--soft);border-radius:20px}
.slide-content{padding:22px 44px 30px;flex:1}
.eyebrow{color:var(--teal);font-size:13px;margin:0 0 4px;font-weight:bold}
h1{font-size:36px;line-height:1.5;margin:0 0 12px;color:var(--navy)}
.lead{font-size:18px;color:var(--muted);margin:0 0 22px;max-width:1000px}
.layout{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(280px,.85fr);gap:28px;align-items:start}
.layout.single{display:block}
h2{font-size:20px;line-height:1.6;margin:0 0 12px}
h3{font-size:16px;margin:0 0 7px}
p{margin:0 0 12px}
.points{list-style:none;padding:0;margin:0}
.points li{padding:11px 25px 11px 0;border-bottom:1px solid var(--line);position:relative}
.points li:before{
  content:"";width:7px;height:7px;border-radius:50%;
  background:var(--teal);position:absolute;right:0;top:23px;
}
.label{font-size:12px;color:var(--teal);font-weight:bold;margin-bottom:7px}
.box{background:var(--soft);padding:18px;border-radius:12px;margin-top:18px}
.box.gold{background:#faf5eb}
.box strong{display:block;margin-bottom:5px;color:var(--navy)}
.detail{font-size:14px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}
.tile{border:1px solid var(--line);padding:18px;border-radius:12px;background:#fff}
.tile .num{font-size:30px;color:var(--teal);font-weight:bold}
.tile p{font-size:14px;color:var(--muted);margin-bottom:0}
.slide-footer{
  border-top:1px solid var(--line);padding:12px 44px;
  display:flex;justify-content:space-between;gap:15px;
  font-size:11px;color:var(--muted);
}
.slide-number{color:var(--teal);font-weight:bold;white-space:nowrap}
.notes{
  display:none;background:#fff9ec;border-top:2px solid var(--gold);
  padding:22px 44px;font-size:15px;line-height:2;
}
.show-notes .slide.active .notes{display:block}
.notes h2{font-size:17px;margin:0 0 10px}
.notes p:last-child{margin:0}
.visual-caption{font-size:11px;color:var(--muted);margin-top:9px}

/* واجهات المنتج المقترحة */
.browser{
  border:1px solid #cbd9e2;border-radius:11px;
  overflow:hidden;background:#fff;box-shadow:0 9px 25px #16364a0b;
}
.chrome{
  background:#eef2f5;padding:8px 12px;display:flex;
  justify-content:space-between;align-items:center;
  direction:ltr;font-size:10px;color:#6c7c89;
}
.dots{display:flex;gap:4px}
.dots i{width:7px;height:7px;border-radius:50%;background:#b2c0ca}
.ui{font-size:12px;line-height:1.6;color:var(--ink)}
.ui-header{
  padding:12px 15px;display:flex;justify-content:space-between;
  align-items:center;border-bottom:1px solid var(--line);gap:12px;
}
.ui-logo{font-weight:bold;color:var(--navy);font-size:16px}
.ui-nav{font-size:10px;color:var(--muted)}
.ui-hero{padding:24px 20px;background:linear-gradient(120deg,#102d45,#1b5668);color:#fff}
.ui-hero h3{font-size:23px;color:#fff;margin:0 0 6px}
.ui-hero p{opacity:.85;font-size:11px}
.ui-search{
  display:flex;gap:6px;padding:6px;background:#fff;
  border-radius:7px;margin-top:14px;align-items:center;
}
.ui-search input{border:0;min-width:0;flex:1;padding:7px;color:var(--ink);font-size:11px;background:#fff}
.ui-btn{
  display:inline-block;background:var(--teal);color:#fff;
  border:0;border-radius:6px;padding:7px 12px;font-size:11px;
  text-decoration:none;text-align:center;
}
.ui-btn.secondary{background:#fff;color:var(--teal);border:1px solid #b9d9d7}
.ui-btn.dark{background:var(--navy)}
.ui-section{padding:15px}
.ui-title{font-weight:bold;font-size:14px;margin-bottom:10px}
.ui-row{display:flex;gap:7px;flex-wrap:wrap;align-items:center}
.pill{background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:6px 9px;font-size:10px;color:var(--ink)}
button.pill{font-family:inherit}
.pill.selected{background:var(--navy);color:#fff;border-color:var(--navy)}
.ui-filters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;margin-bottom:12px}
.ui-field{border:1px solid var(--line);border-radius:5px;padding:7px;background:#fff;font-size:10px}
.ui-field label{display:block;color:var(--muted);font-size:9px}
.ui-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.area-card{border:1px solid var(--line);border-radius:8px;overflow:hidden;background:#fff}
.area-card .inner{padding:10px}
.area-card h4{font-size:12px;margin:0 0 5px}
.area-card p{font-size:9px;color:var(--muted);margin:0 0 8px}
.art{
  height:86px;background:linear-gradient(#b7d5df,#f4e7d3);
  position:relative;overflow:hidden;display:flex;
  align-items:flex-end;justify-content:center;gap:5px;padding:0 10px;
}
.art i{display:block;width:18%;background:#547b90;height:65%}
.art i:nth-child(2){height:90%;background:#2d526a}
.art i:nth-child(3){height:50%;background:#7796a5}
.art i:nth-child(4){height:76%;background:#446b81}
.art small{position:absolute;right:6px;top:5px;background:#ffffffcf;padding:1px 4px;font-size:8px}
.art.warm{background:linear-gradient(#c9e0e4,#f0dfb8)}
.art.warm i{height:35%;background:#b29a72;width:28%}
.compare-bar{background:var(--tint);padding:10px;display:flex;justify-content:space-between;gap:10px;align-items:center;font-size:10px;border-radius:6px;margin-top:12px}
.ui-stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px}
.ui-stat{padding:12px 7px;text-align:center;background:var(--soft);border-radius:6px}
.ui-stat strong{display:block;color:var(--navy);font-size:12px}
.ui-stat small{font-size:9px;color:var(--muted)}
.ui-split{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.ui-panel{background:var(--tint);border-radius:7px;padding:12px;font-size:10px}
.ui-panel.caution{background:#fbf4e8}
.ui-panel ul{padding-right:15px;margin:5px 0}
.ui-tabs{padding:9px 12px;background:var(--navy);color:#fff;font-size:10px;word-spacing:8px}
.mini-table{width:100%;border-collapse:collapse;font-size:10px}
.mini-table th,.mini-table td{padding:9px 7px;border-bottom:1px solid var(--line);text-align:right}
.mini-table th{background:var(--soft)}
.mini-table td small{color:var(--muted)}
.service{padding:12px;border:1px solid var(--line);border-radius:7px;margin-top:8px;display:flex;justify-content:space-between;gap:10px}
.phone{
  max-width:285px;margin:auto;border:7px solid var(--navy);
  border-radius:30px;overflow:hidden;background:#fff;box-shadow:0 8px 25px #102d4510;
}
.phone-top{padding:7px 16px;text-align:left;font-size:9px;background:#fff}
.phone .ui-section{padding:15px}
.phone .ui-hero{padding:20px 14px}
.phone .ui-hero h3{font-size:19px}
.phone .ui-cards{grid-template-columns:1fr}
.phone .art{height:95px}
.phone .ui-stats{grid-template-columns:1fr 1fr}
.choice{display:block;padding:13px 10px;border:1px solid var(--line);border-radius:8px;margin:9px 0;background:#fff;width:100%;text-align:right;color:var(--ink);font-size:12px}
.choice.selected{border-color:var(--teal);background:var(--tint)}
.steps{display:flex;gap:4px;margin:12px 0 18px}
.steps i{height:5px;background:var(--line);border-radius:4px;flex:1}
.steps i.on{background:var(--teal)}
.flow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.flow .tile{border-top:4px solid var(--teal)}
.flow .tile .num{font-size:24px}
.state{padding:18px;border:1px dashed #bdcfd8;background:#fff;border-radius:10px;margin:10px 0;text-align:center}
.state h3{font-size:16px}
.state p{font-size:12px;color:var(--muted)}
.skeleton{height:12px;background:#e5ecf0;border-radius:5px;margin:9px 0}
.skeleton.short{width:65%}
.cover{
  min-height:410px;display:grid;grid-template-columns:1.1fr 1fr;
  align-items:center;gap:30px;background:linear-gradient(115deg,#f0f7f7,#fff);
  padding:35px;border-radius:14px;
}
.cover h2{font-size:32px;line-height:1.6}
.cover .big{font-size:60px;line-height:1.3;color:var(--teal);font-weight:bold}
.tag{display:inline-block;background:#e9f3f3;color:var(--teal);padding:5px 10px;border-radius:6px;font-size:12px;margin:3px}
.decision{padding:25px;background:var(--navy);color:#fff;border-radius:12px;margin-top:18px}
.decision h3{color:#fff;font-size:22px}
.decision p{opacity:.9}
.data-table{width:100%;border-collapse:collapse;font-size:14px}
.data-table th,.data-table td{padding:12px;border-bottom:1px solid var(--line);text-align:right;vertical-align:top}
.data-table th{background:var(--soft);color:var(--navy)}
.table-wrap{overflow:auto}
.bottom-tip{font-size:12px;color:var(--muted);text-align:center;padding:16px}
#toast{min-height:20px;font-size:11px;color:var(--teal);margin-top:7px}
@media(min-width:1500px){
  .slide{min-height:820px}
  h1{font-size:40px}
}
@media(max-width:900px){
  main{padding:0 12px;margin:14px auto}
  .slide-content{padding:20px}
  .slide-head{padding:22px 20px 0}
  .slide-footer{padding:12px 20px}
  .layout{grid-template-columns:1fr}
  .grid,.flow{grid-template-columns:repeat(2,minmax(0,1fr))}
  h1{font-size:28px}
  .lead{font-size:16px}
  .slide{min-height:0}
  .notes{padding:20px}
  .cover{grid-template-columns:1fr;padding:20px}
}
@media(max-width:520px){
  .toolbar{padding:10px}
  .toolbar strong{font-size:13px}
  .toolbar button,.toolbar select{padding:6px 8px;font-size:12px}
  .toolbar select{max-width:195px}
  h1{font-size:24px}
  .grid,.flow{grid-template-columns:1fr}
  .ui-cards{grid-template-columns:1fr}
  .ui-filters,.ui-stats{grid-template-columns:1fr 1fr}
  .ui-nav{display:none}
  .ui-split{grid-template-columns:1fr}
  .ui-hero h3{font-size:20px}
  .slide-footer{font-size:10px}
  .cover .big{font-size:44px}
  .cover h2{font-size:25px}
}
@media print{
  @page{size:A4 landscape;margin:8mm}
  *{-webkit-print-color-adjust:exact;print-color-adjust:exact}
  body{background:#fff;font-size:11px}
  .toolbar,.progress,.bottom-tip{display:none!important}
  main{padding:0;margin:0;max-width:none}
  .slide,.slide.active{
    display:flex!important;flex-direction:column;
    min-height:0;border-radius:0;box-shadow:none;
    break-after:page;page-break-after:always;overflow:visible;
  }
  .slide:last-child{break-after:auto;page-break-after:auto}
  .slide-head{padding:10px 16px 0;font-size:9px}
  .brand{font-size:15px}
  .brand small{font-size:8px}
  .slide-content{padding:10px 16px 14px}
  h1{font-size:25px;margin-bottom:6px}
  .lead{font-size:12px;margin-bottom:12px}
  .layout{grid-template-columns:minmax(0,1.25fr) minmax(230px,.85fr);gap:16px}
  .points li{padding-top:7px;padding-bottom:7px;font-size:11px}
  .points li:before{top:17px}
  .box{padding:10px;margin-top:10px;font-size:10px}
  .detail{font-size:10px}
  .slide-footer{padding:7px 16px;font-size:8px}
  .notes{display:none!important}
  .show-notes .slide .notes{
    display:block!important;padding:10px 16px;
    font-size:10px;line-height:1.7;break-inside:avoid;
  }
  .notes h2{font-size:12px;margin-bottom:5px}
  .tile{padding:12px}
  .tile p{font-size:10px}
  .tile h3{font-size:13px}
  .tile .num{font-size:22px}
  .cover{min-height:280px;padding:22px}
  .cover h2{font-size:27px}
  .cover .big{font-size:45px}
  .data-table{font-size:10px}
  .data-table th,.data-table td{padding:8px}
  .phone{max-width:215px;border-width:5px}
  .phone .ui-section{padding:9px}
  .phone .choice{padding:8px;font-size:10px}
  .ui{font-size:10px}
  .ui-hero{padding:15px}
  .ui-hero h3{font-size:19px}
  .ui-section{padding:10px}
  .art{height:62px}
  .visual-caption{font-size:8px}
  .flow{gap:8px}
  .decision{padding:16px}
  .decision h3{font-size:18px}
}
</style>
</head>
<body>

<header class="toolbar">
  <strong>امتلاك جلوبال · دليل مناطق دبي</strong>
  <div class="tools">
    <button id="prev" type="button">السابق</button>
    <span id="counter" aria-live="polite">1 / 30</span>
    <button id="next" type="button">التالي</button>
    <select id="jump" aria-label="الانتقال إلى سلايد"></select>
    <button id="notesButton" type="button" aria-pressed="false">شرح المتحدث</button>
    <button id="fullButton" type="button">ملء الشاشة</button>
    <button id="printButton" type="button">طباعة / PDF</button>
  </div>
</header>
<div class="progress" aria-hidden="true"><span id="progress"></span></div>
<main id="deck"></main>
<div class="bottom-tip">
  الأسهم للتنقل · زر «شرح المتحدث» لإظهار الملاحظات ·
  للطباعة مع الشرح، أظهره أولاً ثم اختر طباعة / PDF.
</div>

